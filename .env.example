# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings → API Keys). Never commit .env.local.

# The project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (or the legacy "anon" key). Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The "secret" key (or the legacy "service_role" key). Server only – never
# put it in a NEXT_PUBLIC_ variable. Used to delete accounts and by scripts.
SUPABASE_SECRET_KEY=
# The site's address, used in links in emails, e.g. https://leesavontuur.co.za
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: "Draft with AI" (an API key from console.anthropic.com). Secret.
ANTHROPIC_API_KEY=

# Payments (PayFast). Leave as sandbox (practice payments, PayFast's public
# test account) until the owner's PayFast account is ready. Then, in Vercel
# (all Secret): PAYFAST_MODE=live and the merchant ID, merchant key and the
# passphrase set under PayFast → Settings → Developer settings.
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
